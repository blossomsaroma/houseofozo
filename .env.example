# Copy to .env.local for local dev. On Vercel (or similar), set these in the project Environment Variables UI.

GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Sheet1!A:E

# Local only (file is gitignored):
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# Production: paste ONE of these instead of the file (do not commit secrets):
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=<base64 of entire service-account.json>
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional:
# WAITLIST_TIMEZONE=Asia/Kolkata
